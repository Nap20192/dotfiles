#!/bin/bash

CURRENT_RAW=$(dconf read /org/gnome/desktop/interface/color-scheme)
if [ "$CURRENT_RAW" = "'prefer-dark'" ]; then
    CURRENT_STYLE="dark"
else
    CURRENT_STYLE="light"
fi

if [ "$1" = "dark" ]; then
    STYLE="dark"
elif [ "$1" = "light" ]; then
    STYLE="light"
else
    [ "$CURRENT_STYLE" = "dark" ] && STYLE="light" || STYLE="dark"
fi

[ "$STYLE" = "$CURRENT_STYLE" ] && exit 0

