# CAVA — ember gradient to match the amoled theme (orange accent -> ivory fg).
# Only overrides; everything else stays at cava defaults.

[general]
# pick up edits without restarting
live-config = 1

# both monitors run high refresh; 120 keeps motion silky
framerate = 120

bars = 0
bar_width = 2
bar_spacing = 1

# collapse to a flat line and dim after silence
sleep_timer = 3

[output]
# mirror spectrum: lows meet in the middle
channels = stereo
reverse = 0

[color]
# theme = monochrome + one orange accent: gray body (theme secondary),
# peaks flare into the accent. Mid-grays and orange stay readable on both
# the amoled black and the light cream terminal background.
gradient = 1
gradient_count = 5
gradient_color_1 = '#666666'
gradient_color_2 = '#888888'
gradient_color_3 = '#aaaaaa'
gradient_color_4 = '#cc5200'
gradient_color_5 = '#ff6600'

[smoothing]
# monstercat smoothing + waves off = crisp peaks with smooth falloff
monstercat = 1
waves = 0
noise_reduction = 0.72
