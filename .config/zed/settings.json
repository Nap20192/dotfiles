// Zed settings

// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed

// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
    "collaboration_panel": {
        "dock": "right",
    },
    "agent": {
        "dock": "left",
        "favorite_models": [],
        "model_parameters": [],
    },
    "git_panel": {
        "dock": "right",
    },
    "use_system_path_prompts": true,
    "cli_default_open_behavior": "existing_window",
    "session": {
        "trust_all_worktrees": true,
    },
    "vim_mode": true,
    "project_panel": {
        "dock": "right",
        "git_status": false,
        "auto_fold_dirs": false,
    },
    "outline_panel": {
        "dock": "right",
        "git_status": false,
    },
    "base_keymap": "VSCode",
    "preview_tabs": {
        "enabled": false,
    },
    "status_bar": {
        "experimental.show": false,
    },
    "tab_bar": {
        "show": false,
    },
    "tabs": {
        "git_status": false,
    },
    "multi_cursor_modifier": "cmd_or_ctrl",
    "relative_line_numbers": "enabled",
    "sticky_scroll": {
        "enabled": true,
    },
    "fast_scroll_sensitivity": 5.0,
    "gutter": {
        "line_numbers": true,
        "folds": false,
    },
    "minimap": {
        "show": "never",
    },
    "scrollbar": {
        "axes": {
            "horizontal": false,
            "vertical": false,
        },
    },
    "current_line_highlight": "line",
    "cursor_blink": false,
    "autosave": {
        "after_delay": {
            "milliseconds": 1000,
        },
    },
    "buffer_font_family": "Fira Code",
    "show_completions_on_input": false,
    "ensure_final_newline_on_save": true,
    "indent_guides": {
        "enabled": false,
    },
    "soft_wrap": "editor_width",
    "tab_size": 4,
    "agent_servers": {
        "codex-acp": {
            "type": "registry",
        },
    },
    "icon_theme": {
        "mode": "system",
        "light": "Zed (Default)",
        "dark": "Zed (Default)",
    },
    "ui_font_size": 16,
    "buffer_font_size": 15,

    "theme": {
        "mode": "dark",
        "light": "Gruvbox Light",
        "dark": "Catppuccin Espresso (Blur) [Heavy]"
    },
}
