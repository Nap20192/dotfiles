font-family = GoMono Nerd Font
font-size = 12

theme = light:vnkjd-light,dark:vnkjd-dark

window-decoration = none
window-padding-x = 20
window-padding-y = 20,5
window-padding-color = background
window-save-state = never

background-opacity = 1.0
background-opacity-cells = true
background-blur = false

cursor-style = block
cursor-style-blink = false
custom-shader = shaders/cursor_tail.glsl
mouse-hide-while-typing = true

copy-on-select = true
confirm-close-surface = false
shell-integration-features = no-cursor,title,no-sudo,no-ssh-env,no-ssh-terminfo,path

keybind = ctrl+shift+c=copy_to_clipboard:mixed
keybind = ctrl+shift+v=paste_from_clipboard
keybind = ctrl+insert=copy_to_clipboard:mixed
keybind = shift+insert=paste_from_clipboard
keybind = ctrl+shift+r=reload_config
keybind = ctrl+==increase_font_size:1
keybind = ctrl++=increase_font_size:1
keybind = ctrl+-=decrease_font_size:1
keybind = ctrl+0=reset_font_size
